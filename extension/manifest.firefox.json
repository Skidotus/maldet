{
  "manifest_version": 3,
  "name": "MalDet for GitHub",
  "version": "1.0.0",
  "description": "Shows whether a GitHub repository has been scanned by MalDet, and how long ago.",

  "browser_specific_settings": {
    "gecko": {
      "id": "maldet@gmi.edu.my",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  },

  "host_permissions": [
    "https://github.com/*",
    "https://maldet-fyp.my/*",
    "https://www.maldet-fyp.my/*"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["repo.js", "content.js"],
      "css": ["button.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "MalDet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
