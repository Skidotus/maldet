{
  "manifest_version": 3,
  "name": "MalDet for GitHub",
  "version": "1.0.0",
  "description": "Shows whether a GitHub repository has been scanned by MalDet, and how long ago.",

  "browser_specific_settings": {
    "gecko": {
      "id": "maldet@gmi.edu.my",
      "strict_min_version": "115.0"
    }
  },

  "permissions": ["storage"],

  "host_permissions": [
    "https://github.com/*",
    "http://103.233.1.97:5000/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],

  "optional_host_permissions": ["http://*/*", "https://*/*"],

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["button.css"],
      "run_at": "document_idle"
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "MalDet",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
