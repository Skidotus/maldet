# Copy this file to .env and fill in GITHUB_TOKEN. Everything else already
# has a working default.
#
#   cp .env.example .env
#   docker compose up
#
# .env is gitignored — never commit it.


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# A GitHub personal access token. MalDet only reads public repository
# metadata, so this needs NO scopes at all — its only job is lifting the API
# rate limit from 60 requests/hour to 5,000.
#
# Create one: github.com -> Settings -> Developer settings ->
#             Personal access tokens -> Tokens (classic) -> Generate new
#             -> tick nothing under scopes -> Generate
#
# Use your own. Don't reuse a teammate's.
GITHUB_TOKEN=


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Semgrep token, from a free account at semgrep.dev. Without it Semgrep still
# runs, on community rules only — you'll see fewer findings, no errors.
SEMGREP_APP_TOKEN=

# Set to 1 to skip the one-time ~110MB ClamAV signature download. Faster
# first start; ClamAV then reports nothing and the other four engines are
# unaffected. (For context: ClamAV has yet to produce a single hit across the
# whole scan corpus — it is built for compiled malware, not source code.)
SKIP_FRESHCLAM=0

# Host port for the dashboard. Change this if something already owns 5000 —
# a locally-running `python3 app.py`, for instance.
MALDET_PORT=5000

# Which interface that port binds to. 127.0.0.1 means this machine only,
# which is what you want with a reverse proxy in front of it.
#
#   127.0.0.1   local only — the default, and correct behind a proxy
#   0.0.0.0     reachable from the internet, no TLS, no certificate
#
# Browsers treat a plain http:// address on a public IP as untrusted, so a
# browser extension cannot call it and visitors are told the site is not
# secure. Terminating TLS in a proxy and leaving this at 127.0.0.1 fixes
# both and keeps the app off the public internet.
MALDET_BIND=127.0.0.1

# Set to 1 when a reverse proxy (Apache, nginx, Caddy) sits in front and is
# the only thing that can reach MALDET_BIND. Flask then takes the visitor's
# real scheme and host from the X-Forwarded-* headers, so the links it
# generates point at https://your-domain rather than http://127.0.0.1:5000.
# Leave at 0 when the app is exposed directly: those headers are set by
# whoever connects, so trusting them would let any visitor claim any host.
MALDET_TRUST_PROXY=0


# ---------------------------------------------------------------------------
# Database — these defaults are fine. The database is only reachable from
# inside the compose network, not from your host or your network.
# ---------------------------------------------------------------------------
DB_NAME=fyp_scanner
DB_USER=fypuser
DB_PASSWORD=maldet-dev
MYSQL_ROOT_PASSWORD=maldet-root
